# Параметры RemnaBay для compose из этой папки. Скопируйте файл в .env и заполните:
#   cp .env.example .env
#
# В .env — только секреты и инфраструктура, без которых магазин не запустится.
# Всё остальное настраивается в админке. Если обязательный параметр не задан,
# магазин не запускается и называет его (критерий 1.1).
# Пошаговая установка — README.md в этой папке.

# --- Какие файлы compose подключить ------------------------------------------
# Выберите одну строку по своему варианту установки и уберите у неё «#»:
#
# сервер с панелью Remnawave (Nginx или Caddy панели, общая Docker-сеть):
# COMPOSE_FILE=compose.yaml:compose.panel-network.yaml
#
# отдельный сервер, Caddy в контейнере:
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml
#
# отдельный сервер, Nginx и certbot на самом сервере:
# COMPOSE_FILE=compose.yaml:compose.nginx.yaml
#
# Если база магазина на другом сервере, допишите в конец выбранной строки
# :compose.external-db.yaml и задайте DATABASE_URL ниже.

# Домен магазина для Caddy в контейнере — только для варианта с compose.caddy.yaml.
# Без https:// и без слеша в конце, например shop.example.com
# SHOP_DOMAIN=

# --- Telegram -------------------------------------------------------------------

# Токен Telegram-бота от @BotFather.
BOT_TOKEN=

# Client Secret входа в админку через Telegram (OpenID Connect).
# @BotFather → мини-приложение → ваш бот → Login Widget → OpenID Connect
# (переключение необратимо). Там же укажите:
#   Redirect URI:   https://<публичный адрес магазина>/api/admin/auth/telegram/callback
#   Trusted Origin: https://<публичный адрес магазина>
#   Signing Algorithm: RS256
# Client ID — это ID бота, его указывать не нужно.
TELEGRAM_LOGIN_CLIENT_SECRET=

# Telegram ID первого владельца. При каждом запуске этот аккаунт гарантированно
# остаётся владельцем — это и первый вход, и путь восстановления доступа.
OWNER_TELEGRAM_ID=

# --- Панель Remnawave -----------------------------------------------------------

# Адрес панели. На сервере с панелью — адрес во внутренней Docker-сети:
#   PANEL_URL=http://remnawave:3000
# На отдельном сервере — публичный адрес панели, например https://panel.example.com
PANEL_URL=

# API-токен панели: в панели Remnawave — раздел API Tokens.
PANEL_TOKEN=

# --- Магазин --------------------------------------------------------------------

# Публичный адрес магазина, только HTTPS, например https://shop.example.com
# Нужен для вебхуков, страницы-переходника и входа в админку.
PUBLIC_URL=

# Ключ шифрования секретов, которые вводятся в админке (ключи платёжных
# провайдеров). Создаётся один раз командой из README.md. Храните его в надёжном
# месте и не меняйте: без этого ключа сохранённые секреты не расшифровать,
# их придётся ввести в админке заново.
ENCRYPTION_KEY=

# --- База данных ----------------------------------------------------------------

# Пароль встроенной базы (PostgreSQL из compose). Адрес подключения compose
# собирает сам. Создаётся командой из README.md: только латинские буквы и цифры.
# PostgreSQL берёт пароль только при первом запуске: если поменять его здесь
# потом, пароль базы не изменится — для смены есть рецепт в README.md.
POSTGRES_PASSWORD=

# Только если база магазина на другом сервере (вместе с compose.external-db.yaml):
# отдельная база PostgreSQL 18, не база панели.
# Формат: postgresql://пользователь:пароль@хост:порт/база
# DATABASE_URL=

# --- Версия ---------------------------------------------------------------------

# Версия магазина задана в compose.yaml. Здесь её указывают, только чтобы
# поставить предварительную версию, например 0.1.0-rc.1
# REMNABAY_VERSION=
