# Параметры RemnaBay. Скопируйте файл в .env и заполните.
#
# В .env — только секреты и инфраструктура, без которых магазин не запустится
# (docs/04-operator-settings.md). Всё остальное настраивается в админке.
# Все параметры обязательны: если какой-то не задан или пуст, магазин не
# запускается и называет его (критерий 1.1).

# Токен Telegram-бота от @BotFather.
BOT_TOKEN=

# Адрес API панели Remnawave, например https://panel.example.com
# Если магазин на одном сервере с панелью, можно указать адрес во внутренней
# Docker-сети.
PANEL_URL=

# API-токен панели: в панели Remnawave — раздел API Tokens.
PANEL_TOKEN=

# Подключение к PostgreSQL магазина (отдельная база, не база панели).
# Формат: postgresql://пользователь:пароль@хост:порт/база
# Для compose.dev.yaml подходит значение ниже.
DATABASE_URL=postgresql://remnabay:remnabay@db:5432/remnabay

# Telegram ID первого владельца. При каждом запуске этот аккаунт гарантированно
# остаётся владельцем — это и первый вход, и путь восстановления доступа.
OWNER_TELEGRAM_ID=

# Публичный адрес магазина, только HTTPS, например https://shop.example.com
# Нужен для вебхуков, страницы-переходника и входа в админку.
PUBLIC_URL=

# Ключ шифрования секретов, которые вводятся в админке (ключи платёжных
# провайдеров). Создайте его один раз командой
#   docker compose run --rm --no-deps migrate generate-key   (или: uv run remnabay generate-key)
# и вставьте сюда. Храните в надёжном месте и не меняйте: без этого ключа
# сохранённые секреты не расшифровать, их придётся ввести в админке заново.
ENCRYPTION_KEY=
